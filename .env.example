# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (example - adjust based on your needs)
# DATABASE_URL=postgresql://user:password@localhost:5432/homeschool_app
# DATABASE_POOL_SIZE=10

# Authentication (example - adjust based on your needs)
# NEXTAUTH_SECRET=your-secret-here
# NEXTAUTH_URL=http://localhost:3000

# API Keys (example - adjust based on your needs)
# API_KEY=your-api-key-here

# External Services (example - adjust based on your needs)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# Analytics (example - adjust based on your needs)
# NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Feature Flags (example - adjust based on your needs)
# FEATURE_NEW_UI=true
# FEATURE_BETA_ACCESS=false
